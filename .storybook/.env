# Deterministic environment for Storybook. `viteFinal` in main.ts points
# Vite's envDir here so stories never depend on a developer's root .env.
# Firebase is initialised with placeholder values only so `getAuth()` works;
# no network calls are made and the backend is mocked with MSW.
VITE_FIREBASE_APIKEY=storybook
VITE_FIREBASE_AUTHDOMAIN=localhost
VITE_FIREBASE_PROJECTID=organized-storybook
VITE_FIREBASE_APPID=organized-storybook
